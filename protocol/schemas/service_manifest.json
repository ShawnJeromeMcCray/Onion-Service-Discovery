{
  "type": "object",
  "properties": {
    "protocol": {
      "const": "Onion Service Discovery"
    },
    "protocol_version": {
      "const": 1
    },
    "record_type": {
      "const": "service_manifest"
    },
    "onion": {
      "type": "string",
      "minLength": 62,
      "maxLength": 62,
      "pattern": "^[a-z2-7]{56}\\.onion$"
    },
    "service_identity_public_key": {
      "type": "string",
      "minLength": 51,
      "maxLength": 51,
      "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previous_manifest_hash": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "discovery": {
      "type": "object",
      "properties": {
        "publish_service": {
          "type": "boolean"
        },
        "mirror_directory": {
          "type": "boolean"
        },
        "discover_services": {
          "type": "boolean"
        },
        "sync_with_peers": {
          "type": "boolean"
        }
      },
      "required": [
        "publish_service",
        "mirror_directory",
        "discover_services",
        "sync_with_peers"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^[^\u0000-\u001f\u007f-\u009f]*$"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048,
          "pattern": "^[^\u0000-\u001f\u007f-\u009f]*$"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35,
            "pattern": "^(?:(?:(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4}|[a-z]{5,8})(?:-[a-z]{4})?(?:-(?:[a-z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[0-9a-wy-z](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?|x(?:-[a-z0-9]{1,8})+|art-lojban|cel-gaulish|en-gb-oed|i-ami|i-bnn|i-default|i-enochian|i-hak|i-klingon|i-lux|i-mingo|i-navajo|i-pwn|i-tao|i-tay|i-tsu|no-bok|no-nyn|sgn-be-fr|sgn-be-nl|sgn-ch-de|zh-guoyu|zh-hakka|zh-min|zh-min-nan|zh-xiang))$"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "adult",
              "archives",
              "art",
              "audio",
              "blogs",
              "books",
              "business",
              "commerce",
              "communication",
              "community",
              "directories",
              "documentation",
              "education",
              "entertainment",
              "files",
              "finance",
              "forums",
              "games",
              "health",
              "hosting",
              "images",
              "journalism",
              "legal",
              "media",
              "music",
              "other",
              "politics",
              "privacy",
              "research",
              "search",
              "security",
              "services",
              "social",
              "software",
              "technology",
              "tools",
              "video",
              "wiki"
            ]
          },
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "languages",
        "categories"
      ],
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "related_onion_services": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 62,
            "maxLength": 62,
            "pattern": "^[a-z2-7]{56}\\.onion$"
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "clearnet": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2048,
            "pattern": "^https://[^/@\\s]+(?:/[^\\s]*)?$"
          },
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "published_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signature": {
      "type": "string",
      "minLength": 97,
      "maxLength": 97,
      "pattern": "^ed25519sig:[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "protocol",
    "protocol_version",
    "record_type",
    "onion",
    "service_identity_public_key",
    "revision",
    "previous_manifest_hash",
    "discovery",
    "service",
    "signature"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ShawnJeromeMcCray/Onion-Service-Discovery/schemas/draft-v1/service_manifest.json",
  "title": "Onion Service Discovery service_manifest",
  "$comment": "Implementation draft; protocol freeze and human crypto approval are outstanding.",
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "previous_manifest_hash": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_manifest_hash": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "discovery": {
            "properties": {
              "publish_service": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "service": {
            "properties": {
              "name": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
