{
  "type": "object",
  "properties": {
    "protocol": {
      "const": "Onion Service Discovery"
    },
    "protocol_version": {
      "const": 1
    },
    "record_type": {
      "const": "snapshot_descriptor"
    },
    "node_identity_public_key": {
      "type": "string",
      "minLength": 51,
      "maxLength": 51,
      "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previous_checkpoint_hash": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "root_hash": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 2,
            "maximum": 524288
          },
          "record_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256
          }
        },
        "required": [
          "hash",
          "bytes",
          "record_count"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    },
    "signature": {
      "type": "string",
      "minLength": 97,
      "maxLength": 97,
      "pattern": "^ed25519sig:[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "protocol",
    "protocol_version",
    "record_type",
    "node_identity_public_key",
    "generation",
    "previous_checkpoint_hash",
    "created_at",
    "root_hash",
    "record_count",
    "cursor",
    "chunks",
    "signature"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ShawnJeromeMcCray/Onion-Service-Discovery/schemas/draft-v1/snapshot_descriptor.json",
  "title": "Onion Service Discovery snapshot_descriptor",
  "$comment": "Implementation draft; protocol freeze and human crypto approval are outstanding.",
  "allOf": [
    {
      "if": {
        "properties": {
          "generation": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "previous_checkpoint_hash": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_checkpoint_hash": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
