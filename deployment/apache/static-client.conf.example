# Static self-hosting of the built browser client (web-local-search-client/dist),
# without PHP, for Apache httpd 2.4. Equivalent to
# deployment/nginx/static-client.conf.example. Build it with the direct-cross-origin
# profile; see docs/browser/client-contract.md. Tor forwards your Client Host Onion
# to this loopback listener; do not expose it on WAN. Replace paths for the
# supported host. Enable: a2enmod alias dir headers mime reqtimeout
# Set "ServerTokens Prod" in the main configuration; it is a global directive.
Listen 127.0.0.1:8081
<VirtualHost 127.0.0.1:8081>
    ServerName localhost
    DocumentRoot /opt/onion-service-discovery/web-local-search-client/dist
    # No access log: request paths can reveal what visitors look at.
    ErrorLog ${APACHE_LOG_DIR}/onion-service-discovery-client-error.log
    LogLevel crit
    ServerSignature Off
    TraceEnable off
    LimitRequestLine 4094
    LimitRequestFieldSize 4094
    LimitRequestFields 50
    LimitRequestBody 1024
    RequestReadTimeout header=5 body=5
    KeepAliveTimeout 10
    Alias "/onion-service-discovery/" "/opt/onion-service-discovery/web-local-search-client/dist/"
    <Directory /opt/onion-service-discovery/web-local-search-client/dist>
        # No directory listing and, like the PHP host, no symbolic links.
        Options None
        AllowOverride None
        DirectoryIndex index.html
        Require all granted
        # The client accepts config.json and demo.json only as application/json.
        AddType "text/html; charset=utf-8" .html
        AddType "application/javascript; charset=utf-8" .js
        AddType "text/css; charset=utf-8" .css
        AddType "application/json; charset=utf-8" .json
    </Directory>
    # Exactly the files the PHP host serves, at the same paths, for GET and HEAD
    # only. Other methods and paths are refused with 403.
    <Location "/">
        Require all denied
    </Location>
    <LocationMatch "^/onion-service-discovery/(?:index\.html|client\.js|verifier-worker\.js|client\.css|demo\.json|config\.json)?$">
        Require method GET
    </LocationMatch>
    # The same headers as the PHP Client Host (node-php/src/Http/ClientAssets.php).
    # A meta tag cannot set frame-ancestors; this header does. connect-src must also
    # list every Node origin of your build, exactly as the build wrote it into
    # dist/index.html (for example connect-src 'self' http://NODE.onion): the
    # verifier worker makes the data requests under this header's policy.
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Cache-Control "no-store"
</VirtualHost>
