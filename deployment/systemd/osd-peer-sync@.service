[Unit]
Description=Onion Service Discovery bounded peer sync for configured peer %i
After=tor.service

[Service]
Type=oneshot
User=osd-worker
Group=osd
WorkingDirectory=/opt/onion-service-discovery
ExecStart=/usr/bin/php node-php/bin/onion-service-discovery sync:peer-step /etc/onion-service-discovery/node.json %i
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/onion-service-discovery
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
# No capabilities, kernel or device access. MemoryDenyWriteExecute is left out on
# purpose: it breaks the PCRE JIT that PHP uses.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
LimitCORE=0
LimitNOFILE=256
MemoryMax=256M
TasksMax=16
TimeoutStartSec=90
StandardOutput=null
StandardError=null
