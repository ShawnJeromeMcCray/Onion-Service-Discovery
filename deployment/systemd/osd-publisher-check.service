[Unit]
Description=Onion Service Discovery publisher self-check, sampled discoverability evidence and bounded announcement
After=tor.service

[Service]
Type=oneshot
# The same service user as the PHP-FPM pool that serves the status page: it owns the
# private configuration (0700 directory, 0600 file) and writes the evidence the page reads.
User=osd-worker
Group=osd
WorkingDirectory=/opt/onion-service-discovery
# The own Onion is node.onion and the checked Nodes are publisher_nodes in the
# configuration, so config:validate checks them before any step runs.
# A leading "-" keeps later steps running when one fails; each step records its own
# typed result. The order matters: the announcement relies on the fresh self-check
# and per-Node membership that the two steps before it save. The history bundle and
# the Manifest are the public files manifest:install maintains; adjust both paths if
# you install into another webroot.
ExecStart=-/usr/bin/php node-php/bin/onion-service-discovery service:verify /etc/onion-service-discovery/publisher.json --save-status
ExecStart=-/usr/bin/php node-php/bin/onion-service-discovery network:discoverability-check /etc/onion-service-discovery/publisher.json node-php/public/.well-known/onion-service-discovery-history.json --save-status
# Bounded automatic announcement (decision D-018): only for a new revision or a missing
# observation, at most once per day per Node, backoff 1, 2, 4 ... 32 days while a Node
# still lacks the current revision. Delete this line to announce only by hand.
ExecStart=-/usr/bin/php node-php/bin/onion-service-discovery network:announce /etc/onion-service-discovery/publisher.json node-php/public/.well-known/onion-service-discovery.json --if-due
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/onion-service-discovery
# Only the loopback Tor SOCKS listener is reachable: no clearnet fallback.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
# No capabilities, kernel or device access. MemoryDenyWriteExecute is left out on
# purpose: it breaks the PCRE JIT that PHP uses.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
LimitCORE=0
LimitNOFILE=256
MemoryMax=256M
TasksMax=16
TimeoutStartSec=15min
StandardOutput=null
StandardError=null
