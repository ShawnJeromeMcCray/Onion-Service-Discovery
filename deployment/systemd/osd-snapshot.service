[Unit]
Description=Onion Service Discovery bounded signed snapshot publication

[Service]
Type=oneshot
User=osd-worker
Group=osd
WorkingDirectory=/opt/onion-service-discovery
LoadCredential=node-passphrase:/etc/onion-service-discovery/node-passphrase
ExecStart=/usr/bin/php node-php/bin/onion-service-discovery node:snapshot /etc/onion-service-discovery/node.json --passphrase-file %d/node-passphrase
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/onion-service-discovery
RestrictAddressFamilies=AF_UNIX
# Local signing only: no network at all.
PrivateNetwork=yes
# No capabilities, kernel or device access. MemoryDenyWriteExecute is left out on
# purpose: it breaks the PCRE JIT that PHP uses.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# The unlocked Node key must not end up in a core dump.
LimitCORE=0
LimitNOFILE=256
MemoryMax=256M
TasksMax=16
TimeoutStartSec=90
StandardOutput=null
StandardError=null
