; Optional bounded staging pool. A different socket alone is NOT key isolation.
; Establish mount/network/credential isolation before production deployment.
[onion-service-discovery-search]
user = osd-worker
group = osd
listen = /run/php/onion-service-discovery-search.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 2
pm.process_idle_timeout = 5s
pm.max_requests = 100
clear_env = yes
catch_workers_output = no
request_terminate_timeout = 2s
; No core dumps: worker memory holds the submitted search queries.
rlimit_core = 0
security.limit_extensions = .php
php_admin_value[max_execution_time] = 1
php_admin_value[memory_limit] = 128M
; A search form body is at most 8 KiB (8192 bytes), like the web server limit and
; the application's own cap.
php_admin_value[post_max_size] = 8K
php_admin_flag[file_uploads] = off
php_admin_flag[allow_url_fopen] = off
php_admin_flag[allow_url_include] = off
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = off
php_admin_value[expose_php] = Off
