#!/usr/bin/env php
<?php
declare(strict_types=1);

// Operational failures return typed JSON; PHP warnings must not expose paths.
ini_set('display_errors', '0');
ini_set('log_errors', '0');

if (!is_file(dirname(__DIR__) . '/vendor/autoload.php')) {
    echo '{"status":"FAIL","error":"RUNTIME_DEPENDENCIES_MISSING"}', PHP_EOL;
    exit(3);
}
require dirname(__DIR__) . '/vendor/autoload.php';

use OnionServiceDiscovery\Crypto\CanonicalJson;
use OnionServiceDiscovery\Domain\OnionAddress;
use OnionServiceDiscovery\Protocol\IdentityDeriver;
use OnionServiceDiscovery\Protocol\ProtocolException;
use OnionServiceDiscovery\Protocol\RecordVerifier;
use OnionServiceDiscovery\Validation\StrictJson;

function boundedFile(string $path, int $maxBytes): string
{
    if (in_array(basename($path), ['hs_ed25519_secret_key', 'private_key'], true)) { throw new ProtocolException('TOR_KEY_ACCESS_FORBIDDEN'); }
    if (str_contains($path, '://') || !is_file($path) || !is_readable($path)) {
        throw new ProtocolException('INPUT_FILE_UNAVAILABLE');
    }
    $resolved = realpath($path);
    if ($resolved === false) { throw new ProtocolException('INPUT_FILE_UNAVAILABLE'); }
    if (in_array(basename($resolved), ['hs_ed25519_secret_key', 'private_key'], true)) { throw new ProtocolException('TOR_KEY_ACCESS_FORBIDDEN'); }
    $stream = fopen($resolved, 'rb');
    if ($stream === false) {
        throw new ProtocolException('INPUT_FILE_UNAVAILABLE');
    }
    try {
        $bytes = stream_get_contents($stream, $maxBytes + 1);
    } finally {
        fclose($stream);
    }
    if ($bytes === false) {
        throw new ProtocolException('INPUT_FILE_UNAVAILABLE');
    }
    if (strlen($bytes) > $maxBytes) {
        throw new ProtocolException('DOCUMENT_TOO_LARGE');
    }
    return $bytes;
}

function selectedStore(string $backend, string $path, bool $create = false): \OnionServiceDiscovery\Storage\StorageBackend
{
    return match ($backend) {
        'filesystem' => new \OnionServiceDiscovery\Storage\FilesystemStore($path, create: $create),
        'sqlite' => new \OnionServiceDiscovery\Storage\SQLiteStore($path, create: $create),
        default => throw new ProtocolException('STORAGE_BACKEND_INVALID'),
    };
}

function localPassphrase(string $path): string
{
    if (is_link($path) || !is_file($path) || (fileperms($path) & 0077) !== 0) {
        throw new ProtocolException('PASSPHRASE_FILE_UNSAFE');
    }
    $value = boundedFile($path, 1025);
    if (str_ends_with($value, "\n")) { $value = substr($value, 0, -1); }
    if ($value === '' || strlen($value) > 1024) { throw new ProtocolException('PASSPHRASE_POLICY'); }
    return $value;
}

$arguments = array_slice($argv, 1);
$command = array_shift($arguments) ?? 'help';
$arguments = array_values(array_filter($arguments, static fn (string $value): bool => !in_array($value, ['--json', '--no-interaction'], true)));
if (in_array($command, ['key:service:generate', 'key:node:generate'], true)) { array_unshift($arguments, $command === 'key:service:generate' ? 'service' : 'node'); $command = 'key:create'; }
$command = ['manifest:generate'=>'manifest:init', 'storage:verify'=>'storage:check', 'snapshot:build'=>'node:snapshot', 'peer:remove'=>'peers:disable', 'key:service:rotate'=>'manifest:rotate', 'network:discoverability-check'=>'service:membership', 'network:announce'=>'service:announce', 'sync:run'=>'sync:peer-step', 'status'=>'node:status', 'peer:list'=>'peers:list', 'peer:add'=>'peers:add', 'peer:disable'=>'peers:disable', 'backup:create'=>'storage:backup', 'db:verify'=>'storage:check', 'restore:verify'=>'storage:check', 'manifest:show'=>'protocol:inspect'][$command] ?? $command;
$exitCode = 0;
$root = dirname(__DIR__, 2);
$verifier = new RecordVerifier($root . '/protocol/schemas');

try {
    if ($command === 'help') {
        $output = ['status' => 'DEVELOPMENT', 'commands' => ['init <private-config-path> <onion> [--publish]', 'init <private-config-path> [<onion>] --role node|combined|client-host [--sqlite] [--source <onion>]... [--visitor-sources]', 'publisher:status <config>', 'manifest:verify <file>', 'manifest:generate <onion> <service-public-key> <metadata-file>', 'service:verify <config> <onion> [--save-status]', 'service:announce <config> <signed-manifest-file> <node-onion> [--save-status]', 'service:membership <config> <own-history-or-signed-record-file>... --node <node-onion> <expected-node-key> [--node ...] [--save-status]', 'network:discoverability-check (alias of service:membership)', 'network:announce (alias of service:announce)', 'storage:migrate-backend <from-backend> <from-path> <to-backend> <new-staging-path>', 'diagnostics:export <config>', 'node:identity <config>', 'history:install <webroot> <signed-record-file>...', 'history:verify <webroot>', 'status <config> --check (same checks as the status page)', 'storage:verify (alias of storage:check)', 'snapshot:build (alias of node:snapshot)', 'peer:remove (alias of peers:disable; evidence is preserved)', 'key:service:rotate (alias of manifest:rotate)', 'key:node:rotate (unsupported in protocol v1: add a new explicitly pinned Node instead)', 'sync:run <config> <peer-onion> (one bounded step)', 'key:service:generate <key-path> --passphrase-file <file>', 'key:node:generate <key-path> --passphrase-file <file>', 'protocol:inspect <file>', 'protocol:canonicalize <file>', 'protocol:hash <file>', 'protocol:apply-sequence <file>', 'index:verify-inclusion <checkpoint-file> <private-chunks-directory> <own-history-file> <expected-node-key>', 'peers:group <config> <onion> <local-group|--clear>', 'storage:init <filesystem|sqlite> <path>', 'storage:check <backend> <path>', 'storage:admit <backend> <path> <signed-record>', 'storage:backup <backend> <path> <private-backup>', 'storage:restore <backend> <new-staging-path> <private-backup> --trusted-private-backup', 'storage:export <backend> <path> <archive>', 'storage:import <backend> <new-staging-path> <archive>', 'manifest:install <signed-manifest> <public-hostname-file> <webroot> [--rotation <proof>] [--migration <proof>]', 'manifest:init <onion> <service-public-key> <metadata-file>', 'manifest:revise <signed-manifest> <metadata-file>', 'manifest:withdraw <signed-manifest>', 'manifest:rotate <signed-manifest> <new-public-key> [--output-dir <dir>]', 'manifest:migrate <signed-manifest> <new-onion> [--output-dir <dir>]', 'peers:add <config> <onion> --expected-node-key <public-key>', 'peers:list <config>', 'peers:disable <config> <onion>', 'peers:retry <config> <onion> --acknowledge-quarantine', 'sync:peer-step <config> <onion>', 'client:init <config>', 'config:validate <config>', 'doctor <config>', 'security:check <config>', 'release:info', 'backup:verify <private-backup>', 'db:migrate <backend> <path>', 'storage:migrate <backend> <path>', 'candidate:list <config>', 'quarantine:list <config>', 'sync:status <config>', 'node:status <config>', 'node:maintain <config>', 'exports:prune <config> --workers-stopped', 'candidate:add <config> <onion>', 'node:init <config> --passphrase-file <file>', 'node:snapshot <config> --passphrase-file <file> [--rebuild-derived]', 'node:work-one <config> --passphrase-file <file>', 'key:create <service|node> <key-path> --passphrase-file <private-file>', 'record:sign <role> <key-path> <record> --passphrase-file <private-file> [--rotation-confirmation]' ], 'network_side_effects' => false];
    } elseif ($command === 'index:verify-inclusion') {
        if (count($arguments) !== 4) { throw new ProtocolException('USAGE_ERROR'); }
        $checkpointWire = boundedFile($arguments[0], 65536);
        $checkpoint = $verifier->verifyWire($checkpointWire);
        if ($checkpoint->type !== 'snapshot_descriptor') { throw new ProtocolException('SCHEMA_INVALID'); }
        $history = StrictJson::parse(boundedFile($arguments[2], 1048576), 1048576);
        if (array_keys(get_object_vars($history)) !== ['records'] || !is_array($history->records)) { throw new ProtocolException('SCHEMA_INVALID'); }
        $records = [];
        foreach ($history->records as $document) {
            if (!$document instanceof stdClass) { throw new ProtocolException('SCHEMA_INVALID'); }
            $records[] = $verifier->verify($document);
        }
        $blobs = new \OnionServiceDiscovery\Storage\PublicBlobStore($arguments[1]);
        $chunks = (static function () use ($checkpoint, $blobs): Generator {
            foreach ($checkpoint->document()->chunks as $chunk) {
                $wire = $blobs->get($chunk->hash);
                if ($wire === null) { throw new ProtocolException('SNAPSHOT_INCOMPLETE'); }
                yield $wire;
            }
        })();
        $output = (new \OnionServiceDiscovery\Protocol\SnapshotMembership($verifier))->verify($checkpointWire, $chunks, $arguments[3], $records);
        if ($output['status'] !== 'CURRENT_STATE_INCLUDED') { $exitCode = 6; }
    } elseif ($command === 'init') {
        // init CONFIG ONION [--publish] (publisher) | init CONFIG [ONION] --role node|combined|client-host [--sqlite] [--source ONION]... [--visitor-sources]
        $path = array_shift($arguments) ?? throw new ProtocolException('USAGE_ERROR');
        $role = 'publisher'; $onion = null; $publish = false; $sqlite = false; $visitorSources = false; $sources = [];
        while ($arguments !== []) {
            $argument = array_shift($arguments);
            if ($argument === '--publish') { $publish = true; }
            elseif ($argument === '--sqlite') { $sqlite = true; }
            elseif ($argument === '--visitor-sources') { $visitorSources = true; }
            elseif ($argument === '--role') { $role = array_shift($arguments) ?? throw new ProtocolException('USAGE_ERROR'); }
            elseif ($argument === '--source') { $sources[] = OnionAddress::parse(array_shift($arguments) ?? throw new ProtocolException('USAGE_ERROR')); }
            elseif ($onion === null && !str_starts_with($argument, '--')) { $onion = OnionAddress::parse($argument); }
            else { throw new ProtocolException('USAGE_ERROR'); }
        }
        if ($sqlite && !in_array($role, ['node', 'combined'], true)) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\PublisherInitializer::createForRole($path, $role, $onion, $publish, $sources, $visitorSources, $sqlite ? 'sqlite' : 'filesystem');
        $directory = dirname($path);
        $next = match ($role) {
            'publisher' => ['Generate and back up a separate Service key offline, sign and install a public Manifest, then open /onion-service-discovery/status/.'],
            'client-host' => ['Build the browser client: npm --prefix web-local-search-client ci --ignore-scripts && npm --prefix web-local-search-client run build',
                'client:init ' . $path, 'Serve node-php/public/index.php with ONION_SERVICE_DISCOVERY_CONFIG=' . $path],
            default => ['Create an owner-only passphrase file, then: key:create node ' . $directory . '/node.key --passphrase-file PRIVATE_FILE',
                'node:init ' . $path . ' --passphrase-file PRIVATE_FILE', 'node:snapshot ' . $path . ' --passphrase-file PRIVATE_FILE', 'node:identity ' . $path],
        };
        $output = ['status' => 'CONFIGURED', 'role' => $config->role, 'publishing_opt_in' => $config->features['publish_service'], 'features' => $config->features, 'source_count' => count($config->sources),
            'keys_created' => false, 'manifest_installed' => false, 'storage_created' => false, 'network_side_effects' => false, 'next_action' => $role === 'publisher' ? $next[0] . ' Configure selected public sources explicitly; no production seed set is fabricated.' : $next];
    } elseif ($command === 'publisher:status') {
        if (count($arguments) !== 1) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        $output = \OnionServiceDiscovery\Configuration\PublisherStatus::inspect($config, $verifier, dirname(__DIR__) . '/public/.well-known/onion-service-discovery.json', $arguments[0]);
        $output['network_side_effects'] = false;
    } elseif ($command === 'service:announce') {
        $save = in_array('--save-status', $arguments, true);
        $arguments = array_values(array_filter($arguments, static fn (string $value): bool => $value !== '--save-status'));
        if (count($arguments) !== 3) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        if (!$config->features['publish_service'] || $config->nodeOnion === null) { throw new ProtocolException('PUBLISHING_DISABLED'); }
        $address = OnionAddress::parse($config->nodeOnion);
        $record = $verifier->verifyWire(boundedFile($arguments[1], 16384), $address);
        if ($record->type !== 'service_manifest' || !$record->document()->discovery->publish_service) { throw new ProtocolException('PUBLISHING_DISABLED'); }
        $node = OnionAddress::parse($arguments[2]);
        try { $config->transport()->announce($node, $address); }
        catch (\OnionServiceDiscovery\Transport\TransportException $error) {
            if ($save) { \OnionServiceDiscovery\Configuration\PublisherEvidence::recordAnnouncement($arguments[0], time(), $node, $error->getMessage()); }
            throw $error;
        }
        if ($save) { \OnionServiceDiscovery\Configuration\PublisherEvidence::recordAnnouncement($arguments[0], time(), $node, 'HINT_RECEIVED_UNCONFIRMED'); }
        $output = ['status' => 'HINT_RECEIVED_UNCONFIRMED', 'direct_observation' => 'NOT_CONFIRMED', 'index_membership' => 'NOT_CONFIRMED', 'state_mutated' => $save, 'network_side_effects' => true];
    } elseif ($command === 'service:membership') {
        $save = in_array('--save-status', $arguments, true);
        $arguments = array_values(array_filter($arguments, static fn (string $value): bool => $value !== '--save-status'));
        $configPath = array_shift($arguments) ?? throw new ProtocolException('USAGE_ERROR');
        $firstNode = array_search('--node', $arguments, true);
        if ($firstNode === false || $firstNode < 1 || (count($arguments) - $firstNode) % 3 !== 0) { throw new ProtocolException('USAGE_ERROR'); }
        $historyFiles = array_slice($arguments, 0, $firstNode); $arguments = array_slice($arguments, $firstNode);
        if (count($historyFiles) > 256) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($configPath);
        if ($config->role === 'client-host') { throw new ProtocolException('ROLE_CONFIGURATION_INVALID'); }
        // Each file is an index:verify-inclusion history ({"records": [...]}) or one signed record,
        // so a publisher can pass every signed revision and proof file directly.
        $history = [];
        foreach ($historyFiles as $file) {
            $document = StrictJson::parse(boundedFile($file, 1048576), 1048576);
            $documents = array_keys(get_object_vars($document)) === ['records'] ? $document->records : [$document];
            if (!is_array($documents)) { throw new ProtocolException('SCHEMA_INVALID'); }
            foreach ($documents as $record) {
                if (!$record instanceof stdClass || count($history) >= 256) { throw new ProtocolException('SCHEMA_INVALID'); }
                $history[] = $verifier->verify($record);
            }
        }
        $sources = [];
        foreach (array_chunk($arguments, 3) as $triple) {
            if ($triple[0] !== '--node') { throw new ProtocolException('USAGE_ERROR'); }
            $sources[] = [$triple[1], $triple[2]];
        }
        $transport = $config->transport();
        $now = time();
        $output = (new \OnionServiceDiscovery\Configuration\PublisherMembership($verifier, $transport->get(...)))->check($history, $sources, $now);
        if ($save) { \OnionServiceDiscovery\Configuration\PublisherEvidence::recordMembership($output, $configPath, $now); $output['state_mutated'] = true; $output['saved_status_evidence'] = 'AGGREGATES_ONLY'; }
        if ($output['status'] !== 'CURRENT_STATE_INCLUDED_AT_ALL_SELECTED') { $exitCode = 6; }
    } elseif ($command === 'history:install' || $command === 'history:verify') {
        // PCP-004 public history bundle beside the installed Manifest in WEBROOT.
        if (($command === 'history:verify' && count($arguments) !== 1) || ($command === 'history:install' && (count($arguments) < 2 || count($arguments) > 257))) { throw new ProtocolException('USAGE_ERROR'); }
        $installer = new \OnionServiceDiscovery\Signing\HistoryInstaller($verifier);
        if ($command === 'history:verify') {
            $output = ['status' => 'PASS'] + $installer->check($arguments[0]) + ['network_side_effects' => false];
            if ($output['state'] !== 'CONNECTED') { $output['status'] = 'WARN'; $exitCode = 6; }
        } else {
            $records = [];
            foreach (array_slice($arguments, 1) as $file) {
                $document = StrictJson::parse(boundedFile($file, 1048576), 1048576);
                foreach (array_keys(get_object_vars($document)) === ['records'] && is_array($document->records) ? $document->records : [$document] as $entry) {
                    if (!$entry instanceof stdClass) { throw new ProtocolException('SCHEMA_INVALID'); }
                    $records[] = $verifier->verify($entry);
                }
            }
            $output = ['status' => 'INSTALLED'] + $installer->rebuild($arguments[0], $records) + ['public_records_only' => true, 'network_side_effects' => false];
        }
    } elseif ($command === 'node:identity') {
        if (count($arguments) !== 1) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        if (!in_array($config->role, ['node', 'combined'], true)) { throw new ProtocolException('ROLE_CONFIGURATION_INVALID'); }
        $store = $config->store(readOnly: true);
        $identity = \OnionServiceDiscovery\Configuration\NodeStatus::identity($config, $verifier, $store, $store->snapshot());
        if ($identity === null) { throw new ProtocolException('NODE_NOT_INITIALIZED'); }
        [$onion, $key] = [$identity['node_onion'], $identity['node_identity_public_key']];
        $output = ['status' => 'PASS'] + $identity + ['share' => [
            'publishers' => '--node ' . $onion . ' ' . $key,
            'peers' => 'peers:add CONFIG ' . $onion . ' --expected-node-key ' . $key,
            'visitors' => 'Add a Node you chose: onion ' . $onion . ', expected Node key ' . $key,
        ], 'advice' => 'Give these public values through a channel others trust. They prove which key signs this Node, not who operates it.', 'network_side_effects' => false];
    } elseif ($command === 'key:node:rotate') {
        // Protocol v1 has no Node key-rotation proof; a new key is a new, separately pinned source.
        throw new ProtocolException('NODE_KEY_ROTATION_UNSUPPORTED');
    } elseif ($command === 'storage:migrate-backend') {
        if (count($arguments) !== 4) { throw new ProtocolException('USAGE_ERROR'); }
        [$fromBackend, $fromPath, $toBackend, $toPath] = $arguments;
        if (file_exists($toPath)) { throw new \OnionServiceDiscovery\Storage\StorageException('RESTORE_REQUIRES_EMPTY_STAGING_STORE'); }
        $source = match ($fromBackend) {
            'filesystem' => new \OnionServiceDiscovery\Storage\FilesystemStore($fromPath, readOnly: true),
            'sqlite' => new \OnionServiceDiscovery\Storage\SQLiteStore($fromPath, readOnly: true),
            default => throw new ProtocolException('STORAGE_BACKEND_INVALID'),
        };
        if (!in_array($toBackend, ['filesystem', 'sqlite'], true)) { throw new ProtocolException('STORAGE_BACKEND_INVALID'); }
        // The backend-neutral private backup format is the migration carrier; it never leaves the destination's parent directory.
        $carrier = dirname($toPath) . '/.osd-migrate-' . bin2hex(random_bytes(12)) . '.backup';
        try {
            $exported = \OnionServiceDiscovery\Storage\PrivateBackup::export($source, $carrier);
            $destination = selectedStore($toBackend, $toPath, true);
            $restored = \OnionServiceDiscovery\Storage\PrivateBackup::restore($destination, $carrier, $verifier);
            $destination->integrityCheck();
        } finally { if (is_file($carrier)) { unlink($carrier); } }
        $output = ['status' => 'PASS', 'from_backend' => $source->backendName(), 'to_backend' => $destination->backendName(), 'record_count' => $exported['record_count'],
            'restored' => $restored, 'staging_only' => true, 'source_mutated' => false,
            'next_action' => 'Stop workers, run storage:check on the new path, then point the configuration at it. Keep the old store until the new one is verified.'];
    } elseif ($command === 'diagnostics:export') {
        if (count($arguments) !== 1) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        $output = \OnionServiceDiscovery\Configuration\SupportBundle::create($config, $verifier, $arguments[0]);
    } elseif ($command === 'service:verify') {
        $save = in_array('--save-status', $arguments, true);
        $arguments = array_values(array_filter($arguments, static fn (string $value): bool => $value !== '--save-status'));
        if (count($arguments) !== 2) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        if ($config->role === 'client-host') { throw new ProtocolException('ROLE_CONFIGURATION_INVALID'); }
        $address = OnionAddress::parse($arguments[1]);
        // Saved self-verification is only meaningful for this installation's own Onion.
        if ($save && $config->nodeOnion !== $address->hostname) { throw new ProtocolException('SELF_VERIFICATION_ONION_MISMATCH'); }
        try {
            $record = $verifier->verifyWire($config->transport()->get($address, \OnionServiceDiscovery\Transport\ProtocolEndpoint::manifest()), $address);
            if ($record->type !== 'service_manifest') { throw new ProtocolException('SCHEMA_INVALID'); }
        } catch (\OnionServiceDiscovery\Transport\TransportException | \InvalidArgumentException $error) {
            if ($save) { \OnionServiceDiscovery\Configuration\PublisherEvidence::recordSelfVerification($arguments[0], time(), null, $error->getMessage()); }
            throw $error;
        }
        if ($save) { \OnionServiceDiscovery\Configuration\PublisherEvidence::recordSelfVerification($arguments[0], time(), $record->contentHash, 'SIGNATURE_AND_BINDING_VALID'); }
        $document = $record->document();
        // PCP-004: report whether Nodes can connect this Manifest from the served history bundle.
        try { $history = (new \OnionServiceDiscovery\Protocol\ServiceHistory($verifier))->verify($config->transport()->get($address, \OnionServiceDiscovery\Transport\ProtocolEndpoint::history()), $record, [])['state']; }
        catch (\OnionServiceDiscovery\Transport\TransportException) { $history = $document->revision === 1 ? 'NOT_SERVED_GENESIS_NEEDS_NONE' : 'MISSING'; }
        catch (\InvalidArgumentException $error) { $history = 'INVALID_' . $error->getMessage(); }
        $output = ['status' => 'SIGNATURE_AND_BINDING_VALID', 'history_bundle' => $history, 'onion' => $address->hostname, 'manifest_hash' => $record->contentHash, 'service_identity_public_key' => $document->service_identity_public_key, 'revision' => $document->revision, 'publish_service' => $document->discovery->publish_service, 'identity_state' => 'NOT_DERIVED', 'state_mutated' => $save, 'network_side_effects' => true];
    } elseif ($command === 'backup:verify') {
        if (count($arguments) !== 1) { throw new ProtocolException('USAGE_ERROR'); }
        $output = ['status' => 'PASS', 'backup' => \OnionServiceDiscovery\Storage\PrivateBackup::verify($arguments[0], $verifier)];
    } elseif ($command === 'storage:migrate') {
        if (count($arguments) !== 2) { throw new ProtocolException('USAGE_ERROR'); }
        $output = match ($arguments[0]) {
            'filesystem' => \OnionServiceDiscovery\Storage\FilesystemStore::migrateFormat($arguments[1]),
            'sqlite' => ['status' => 'UNCHANGED', 'storage_schema' => (new \OnionServiceDiscovery\Storage\SQLiteStore($arguments[1], readOnly: true))->snapshot()['storage_schema']],
            default => throw new ProtocolException('STORAGE_BACKEND_INVALID'),
        };
    } elseif ($command === 'db:migrate') {
        if (count($arguments) !== 2) { throw new ProtocolException('USAGE_ERROR'); }
        $store = match ($arguments[0]) {
            'filesystem' => new \OnionServiceDiscovery\Storage\FilesystemStore($arguments[1], readOnly: true),
            'sqlite' => new \OnionServiceDiscovery\Storage\SQLiteStore($arguments[1], readOnly: true),
            default => throw new ProtocolException('STORAGE_BACKEND_INVALID'),
        };
        $output = ['status' => 'PASS', 'storage_schema' => $store->snapshot()['storage_schema'], 'migration_performed' => false, 'message' => 'Schema 1 is current; unknown schemas are refused.'];
    } elseif ($command === 'release:info') {
        if ($arguments !== []) { throw new ProtocolException('USAGE_ERROR'); }
        $output = ['status' => 'DEVELOPMENT', 'software_version' => '0.1.0-dev', 'protocol_versions' => [1], 'storage_schema' => 1, 'production_approved' => false, 'gates' => json_decode(boundedFile($root . '/docs/release-gates.json', 65536), true, 16, JSON_THROW_ON_ERROR)];
    } elseif (in_array($command, ['candidate:list', 'quarantine:list', 'sync:status'], true)) {
        if (count($arguments) !== 1) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        if ($config->role === 'client-host') { throw new ProtocolException('ROLE_CONFIGURATION_INVALID'); }
        $state = $config->store(readOnly: true)->snapshot();
        $table = $command === 'sync:status' ? 'sync' : 'candidates'; $rows = []; $eligible = 0;
        foreach ($state['tables'][$table] as $key => $row) {
            if ($command === 'quarantine:list' && ($row['state'] ?? null) !== 'QUARANTINED') { continue; }
            ++$eligible;
            if (count($rows) >= 256) { continue; }
            $rows[] = ['onion' => substr($key, 4), 'state' => $row['state'] ?? null, 'error' => $row['error'] ?? null, 'next_attempt' => $row['next_attempt'] ?? null, 'generation' => $row['generation'] ?? null, 'cursor' => $row['cursor'] ?? null];
        }
        $output = ['status' => 'PASS', 'rows' => $rows, 'limit' => 256, 'partial' => $eligible > count($rows), 'network_side_effects' => false];
    } elseif ($command === 'client:init') {
        if (count($arguments) !== 1) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        if (!in_array($config->role, ['client-host', 'combined'], true)) { throw new ProtocolException('ROLE_CONFIGURATION_INVALID'); }
        new \OnionServiceDiscovery\Storage\PublicBlobStore($config->exportPath, true);
        $output = ['status' => 'INITIALIZED', 'role' => $config->role, 'source_count' => count($config->sources), 'signing_keys_required' => false];
    } elseif ($command === 'config:validate' || $command === 'doctor' || $command === 'security:check') {
        if (count($arguments) !== 1) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        $output = ['status' => 'PASS', 'role' => $config->role, 'storage_backend' => $config->backend, 'features' => $config->features, 'source_count' => count($config->sources), 'network_side_effects' => false];
        if ($command !== 'config:validate') {
            $output = \OnionServiceDiscovery\Configuration\Diagnostics::inspect($config, $verifier);
            $exitCode = $output['status'] === 'FAIL' ? 4 : ($output['status'] === 'WARN' ? 6 : 0);
        }
    } elseif ($command === 'peers:group') {
        if (count($arguments) !== 3) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        if (in_array($config->role, ['publisher', 'client-host'], true)) { throw new ProtocolException('ROLE_CONFIGURATION_INVALID'); }
        \OnionServiceDiscovery\Node\PeerRegistry::group($config->store(), OnionAddress::parse($arguments[1]), $arguments[2] === '--clear' ? null : $arguments[2]);
        $output = ['status' => 'PASS', 'grouping' => 'LOCAL_OPERATOR_POLICY', 'identity_authority_changed' => false, 'network_side_effects' => false];
    } elseif (in_array($command, ['peers:add','peers:list','peers:disable','peers:retry','sync:peer-step'], true)) {
        $expectedCount = $command === 'peers:add' ? 4 : ($command === 'peers:list' ? 1 : ($command === 'peers:retry' ? 3 : 2));
        if (count($arguments) !== $expectedCount || ($command === 'peers:add' && $arguments[2] !== '--expected-node-key') || ($command === 'peers:retry' && $arguments[2] !== '--acknowledge-quarantine')) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        if ($config->role === 'client-host') { throw new ProtocolException('ROLE_CONFIGURATION_INVALID'); }
        $store = $config->store();
        if ($command === 'peers:list') {
            $output = ['status' => 'PASS', 'peers' => $store->snapshot()['tables']['peers']];
        } else {
            $onion = OnionAddress::parse($arguments[1]);
            if ($command === 'peers:add') { $output = ['status' => 'PASS', 'inserted' => \OnionServiceDiscovery\Node\PeerRegistry::add($store,$onion,$arguments[3])]; }
            elseif ($command === 'sync:peer-step') {
                if (!$config->features['sync_with_peers']) { throw new ProtocolException('SYNC_DISABLED'); }
                $output = (new \OnionServiceDiscovery\Node\PeerSync($store,$verifier,$config->transport(),$config->features['discover_services']))->step($onion,time());
            } else {
                $store->transaction(static function (\OnionServiceDiscovery\Storage\StorageTransaction $tx) use ($onion,$command): void {
                    $row=$tx->get('peers',$onion->hostname); if($row===null) { throw new ProtocolException('PEER_NOT_CONFIGURED'); }
                    $row['state']=$command==='peers:disable'?'DISABLED':'CANDIDATE'; $row['claim']=null; $row['lease_until']=0; $row['next_attempt']=0; $row['failures']=0; $tx->set('peers',$onion->hostname,$row);
                });
                $output=['status'=>'PASS','evidence_preserved'=>true];
            }
        }
    } elseif ($command === 'manifest:install') {
        if (count($arguments) < 3 || count($arguments) > 7 || (count($arguments)-3)%2!==0) { throw new ProtocolException('USAGE_ERROR'); }
        $rotation=null; $migration=null;
        for($index=3;$index<count($arguments);$index+=2){
            $proof=$verifier->verifyWire(boundedFile($arguments[$index+1],65536));
            if($arguments[$index]==='--rotation'&&$rotation===null)$rotation=$proof;
            elseif($arguments[$index]==='--migration'&&$migration===null)$migration=$proof;
            else throw new ProtocolException('USAGE_ERROR');
        }
        $output=(new \OnionServiceDiscovery\Signing\ManifestInstaller($verifier))->install($verifier->verifyWire(boundedFile($arguments[0],16384)),$arguments[1],$arguments[2],$rotation,$migration);
    } elseif (in_array($command, ['manifest:init','manifest:revise','manifest:withdraw','manifest:rotate','manifest:migrate'], true)) {
        $count=$command==='manifest:init'?3:($command==='manifest:withdraw'?1:2);
        // Rotation/migration produce two drafts; --output-dir writes each to its own file for record:sign.
        $outputDirectory=null;
        if(in_array($command,['manifest:rotate','manifest:migrate'],true)&&count($arguments)===$count+2&&$arguments[$count]==='--output-dir'){$outputDirectory=$arguments[$count+1];$arguments=array_slice($arguments,0,$count);}
        if(count($arguments)!==$count) { throw new ProtocolException('USAGE_ERROR'); }
        $builder=new \OnionServiceDiscovery\Signing\ManifestDraftBuilder($verifier);
        if($command==='manifest:init') { $output=$builder->genesis(OnionAddress::parse($arguments[0]),$arguments[1],StrictJson::parse(boundedFile($arguments[2],16384),16384)); }
        else {
            $current=$verifier->verifyWire(boundedFile($arguments[0],65536));
            $output=match($command) {
                'manifest:revise'=>$builder->revise($current,StrictJson::parse(boundedFile($arguments[1],16384),16384)),
                'manifest:withdraw'=>$builder->withdraw($current),
                'manifest:rotate'=>$builder->rotate($current,$arguments[1]),
                'manifest:migrate'=>$builder->migrate($current,OnionAddress::parse($arguments[1])),
            };
            if($outputDirectory!==null) {
                if(str_contains($outputDirectory,'://')||is_link($outputDirectory)||!is_dir($outputDirectory)||!is_writable($outputDirectory)) { throw new ProtocolException('OUTPUT_DIRECTORY_UNAVAILABLE'); }
                $files=[];
                foreach($output as $name=>$draft) {
                    $path=rtrim($outputDirectory,'/').'/'.($name==='successor_manifest'?'successor-draft.json':($name==='rotation_record'?'rotation-draft.json':'migration-draft.json'));
                    $mask=umask(0077); try { $stream=@fopen($path,'xb'); } finally { umask($mask); }
                    if($stream===false) { throw new ProtocolException('OUTPUT_FILE_EXISTS_OR_UNAVAILABLE'); }
                    try { $bytes=json_encode($draft,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE)."\n"; if(fwrite($stream,$bytes)!==strlen($bytes)) { throw new ProtocolException('OUTPUT_FILE_EXISTS_OR_UNAVAILABLE'); } } finally { fclose($stream); }
                    $files[$name]=$path;
                }
                $output=['status'=>'DRAFTS_WRITTEN','files'=>$files,'signed'=>false,'next_action'=>$command==='manifest:rotate'
                    ?'Sign rotation-draft.json with the old key, then with the new key using --rotation-confirmation; sign successor-draft.json with the new key; install with --rotation.'
                    :'Sign migration-draft.json and successor-draft.json with the current key; install the successor on the new Onion with --migration.'];
            }
        }
    } elseif ($command === 'exports:prune') {
        if (count($arguments) !== 2 || $arguments[1] !== '--workers-stopped') { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        if ($config->role === 'client-host') { throw new ProtocolException('ROLE_CONFIGURATION_INVALID'); }
        $state = $config->store()->snapshot();
        $published = $state['tables']['node']['key:published-snapshot'] ?? null;
        if ($published === null) { throw new ProtocolException('SNAPSHOT_UNAVAILABLE'); }
        $blobs = new \OnionServiceDiscovery\Storage\PublicBlobStore($config->exportPath);
        $wire = $config->store()->readRecord($published['hash']);
        if ($wire === null) { throw new ProtocolException('STORAGE_CORRUPT'); }
        $checkpoint = $verifier->verifyWire($wire); $keep = [$checkpoint->contentHash];
        foreach ($checkpoint->document()->chunks as $chunk) {
            $body = $blobs->get($chunk->hash);
            if ($body === null || strlen($body) !== $chunk->bytes || \OnionServiceDiscovery\Protocol\SnapshotFormat::chunkHash($body) !== $chunk->hash) { throw new ProtocolException('EXPORT_CORRUPT'); }
            $keep[] = $chunk->hash;
        }
        foreach ($state['tables']['node'] as $key => $row) { if (str_starts_with($key, 'key:service-index-')) { $keep[] = $row['hash']; } }
        $search = $state['tables']['node']['key:server-search-index'] ?? null;
        if ($search !== null) { $keep = array_merge($keep, \OnionServiceDiscovery\Search\SearchIndex::references($blobs, $search['hash'])); }
        $output = ['status' => 'PASS', 'prune' => $blobs->pruneUnreferenced(array_values(array_unique($keep))), 'network_side_effects' => false];
    } elseif ($command === 'node:status' && count($arguments) === 2 && $arguments[1] === '--check') {
        // `status CONFIG --check`: the same read-only derivation as /onion-service-discovery/status/ (spec 47 section 48).
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        $output = \OnionServiceDiscovery\Configuration\PublisherStatus::inspect($config, $verifier, dirname(__DIR__) . '/public/.well-known/onion-service-discovery.json', $arguments[0]);
        $output['node'] = \OnionServiceDiscovery\Configuration\NodeStatus::inspect($config, $verifier, time());
        $output['network_side_effects'] = false;
        // 0: nothing needs attention; 6: waiting or degraded; 4: error or identity conflict.
        $exitCode = in_array($output['overall'], ['ERROR', 'IDENTITY_CONFLICT'], true) || ($output['node']['storage_state'] ?? null) === 'ERROR' ? 4
            : (in_array($output['overall'], ['READY_LOCALLY', 'DISCOVERABLE_DEGRADED'], true) || ($output['node']['identity'] ?? null) === 'NOT_INITIALIZED' ? 6 : 0);
    } elseif ($command === 'node:status' || $command === 'node:maintain') {
        if (count($arguments) !== 1) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        if ($config->role === 'client-host') { throw new ProtocolException('ROLE_CONFIGURATION_INVALID'); }
        $store = $config->store(readOnly: $command === 'node:status');
        if ($command === 'node:maintain') {
            $checkpoint = $store instanceof \OnionServiceDiscovery\Storage\SQLiteStore ? $store->checkpoint() : null;
            $output = ['status' => 'PASS', 'sqlite_checkpoint' => $checkpoint, 'maintenance' => (new \OnionServiceDiscovery\Node\LocalMaintenance($store))->run(time()), 'network_side_effects' => false];
        } else {
            $state = $store->snapshot(); $counts = array_map('count', $state['tables']);
            $output = ['status' => 'PASS', 'backend' => $store->backendName(), 'storage_generation' => $state['generation'], 'signed_records' => count($state['records']), 'operational_counts' => $counts, 'network_side_effects' => false, 'aggregate_only' => true];
        }
    } elseif ($command === 'candidate:add') {
        if (count($arguments) !== 2) { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        if (!$config->features['discover_services'] || $config->role === 'client-host') { throw new ProtocolException('DISCOVERY_DISABLED'); }
        $inserted = (new \OnionServiceDiscovery\Node\CandidateQueue($config->store()))->enqueue(OnionAddress::parse($arguments[1]));
        $output = ['status' => $inserted ? 'QUEUED' : 'NOT_INSERTED', 'inserted' => $inserted, 'network_side_effects' => false];
    } elseif (in_array($command, ['node:init', 'node:snapshot', 'node:work-one'], true)) {
        $rebuildDerived = $command === 'node:snapshot' && count($arguments) === 4 && $arguments[3] === '--rebuild-derived';
        if ($rebuildDerived) { array_pop($arguments); }
        if (count($arguments) !== 3 || $arguments[1] !== '--passphrase-file') { throw new ProtocolException('USAGE_ERROR'); }
        $config = \OnionServiceDiscovery\Configuration\NodeConfig::load($arguments[0]);
        if ($config->role === 'client-host' || $config->nodeKeyPath === null) { throw new ProtocolException('ROLE_CONFIGURATION_INVALID'); }
        if ($command === 'node:snapshot' && !$config->features['mirror_directory'] && !$config->features['server_search']) { throw new ProtocolException('MIRROR_DISABLED'); }
        if ($command === 'node:work-one' && !$config->features['discover_services']) { throw new ProtocolException('DISCOVERY_DISABLED'); }
        $passphrase = localPassphrase($arguments[2]);
        try { $signer = \OnionServiceDiscovery\Signing\ProtectedFileSigner::open($config->nodeKeyPath, 'node', $passphrase, $verifier); }
        finally { sodium_memzero($passphrase); }
        if ($command !== 'node:init') {
            $identityStore = $config->store(readOnly: true); $own = $identityStore->snapshot()['tables']['node']['key:descriptor'] ?? null;
            if ($own === null) { throw new ProtocolException('NODE_NOT_INITIALIZED'); }
            $identityWire = $identityStore->readRecord($own['hash']);
            if ($identityWire === null) { throw new ProtocolException('STORAGE_CORRUPT'); }
            $identity = $verifier->verifyWire($identityWire)->document();
            if ($identity->node_identity_public_key !== $signer->publicKey() || $identity->node_onion !== $config->nodeOnion) { throw new ProtocolException('NODE_IDENTITY_CHANGED'); }
        }
        if ($command === 'node:init') {
            $output = \OnionServiceDiscovery\Node\NodeInitializer::initialize($config, $signer, $verifier);
        } elseif ($command === 'node:snapshot') {
            $output = (new \OnionServiceDiscovery\Node\SnapshotProducer($config->store(), new \OnionServiceDiscovery\Storage\PublicBlobStore($config->exportPath, repairDerived: $rebuildDerived), $verifier, $signer, $config->features['server_search'], $rebuildDerived))->publish(time());
        } else {
            $output = (new \OnionServiceDiscovery\Node\DirectVerifier($config->store(), $verifier, $config->transport(), $signer))->runOne(time());
        }
        unset($signer);
    } elseif ($command === 'storage:backup' || $command === 'storage:restore') {
        $restore = $command === 'storage:restore';
        if (count($arguments) !== ($restore ? 4 : 3) || ($restore && $arguments[3] !== '--trusted-private-backup')) { throw new ProtocolException('USAGE_ERROR'); }
        $store = selectedStore($arguments[0], $arguments[1], $restore);
        $output = ['status' => 'PASS', 'backup' => $restore
            ? \OnionServiceDiscovery\Storage\PrivateBackup::restore($store, $arguments[2], $verifier)
            : \OnionServiceDiscovery\Storage\PrivateBackup::export($store, $arguments[2])];
    } elseif (in_array($command, ['storage:init', 'storage:check', 'storage:admit', 'storage:export', 'storage:import'], true)) {
        $required = in_array($command, ['storage:init', 'storage:check'], true) ? 2 : 3;
        if (count($arguments) !== $required) { throw new ProtocolException('USAGE_ERROR'); }
        $store = selectedStore($arguments[0], $arguments[1], in_array($command, ['storage:init', 'storage:import'], true));
        if ($command === 'storage:init' || $command === 'storage:check') {
            $output = ['status' => 'PASS', 'backend' => $store->backendName(), 'integrity' => $store->integrityCheck()];
        } elseif ($command === 'storage:admit') {
            $record = $verifier->verifyWire(boundedFile($arguments[2], 65536));
            $inserted = $store->transaction(static fn (\OnionServiceDiscovery\Storage\StorageTransaction $tx): bool => $tx->putRecord($record));
            $output = ['status' => 'PASS', 'inserted' => $inserted, 'content_hash' => $record->contentHash, 'directly_observed' => false];
        } elseif ($command === 'storage:export') {
            $output = ['status' => 'PASS', 'archive' => \OnionServiceDiscovery\Storage\RecordArchive::export($store, $arguments[2])];
        } else {
            $output = ['status' => 'PASS', 'archive' => \OnionServiceDiscovery\Storage\RecordArchive::import($store, $arguments[2], $verifier), 'staging_only' => true];
        }
    } elseif ($command === 'key:create' || $command === 'record:sign') {
        $confirmation = false;
        if (end($arguments) === '--rotation-confirmation') { array_pop($arguments); $confirmation = true; }
        $offset = $command === 'key:create' ? 2 : 3;
        if (count($arguments) !== $offset + 2 || $arguments[$offset] !== '--passphrase-file' || ($command === 'key:create' && $confirmation)) { throw new ProtocolException('USAGE_ERROR'); }
        $passphrase = localPassphrase($arguments[$offset + 1]);
        try {
            $signer = $command === 'key:create'
                ? \OnionServiceDiscovery\Signing\ProtectedFileSigner::create($arguments[1], $arguments[0], $passphrase, $verifier)
                : \OnionServiceDiscovery\Signing\ProtectedFileSigner::open($arguments[1], $arguments[0], $passphrase, $verifier);
        } finally { sodium_memzero($passphrase); }
        if ($command === 'key:create') {
            $output = ['status' => 'PASS', 'role' => $signer->role(), 'public_key' => $signer->publicKey()];
        } else {
            $record = StrictJson::parse(boundedFile($arguments[2], 65536), 65536);
            if (!$record instanceof stdClass) { throw new ProtocolException('SCHEMA_INVALID'); }
            $output = $signer->signRecord($record, $confirmation);
        }
        unset($signer);
    } elseif (in_array($command, ['manifest:verify', 'validate-manifest', 'protocol:inspect', 'protocol:hash'], true)) {
        $path = array_shift($arguments);
        if ($path === null) {
            throw new ProtocolException('USAGE_ERROR');
        }
        $binding = null;
        if ($arguments !== []) {
            if (count($arguments) !== 2 || $arguments[0] !== '--expected-onion') {
                throw new ProtocolException('USAGE_ERROR');
            }
            $binding = OnionAddress::parse($arguments[1]);
        }
        $record = $verifier->verifyWire(boundedFile($path, 65536), $binding);
        if (in_array($command, ['manifest:verify', 'validate-manifest'], true) && $record->type !== 'service_manifest') {
            throw new ProtocolException('SCHEMA_INVALID');
        }
        $output = ['status' => 'PASS', 'record_type' => $record->type, 'content_hash' => $record->contentHash, 'signature_valid' => true, 'directly_observed' => false];
    } elseif (in_array($command, ['protocol:canonicalize', 'canonicalize'], true)) {
        if (count($arguments) !== 1) {
            throw new ProtocolException('USAGE_ERROR');
        }
        $bytes = CanonicalJson::encode(StrictJson::parse(boundedFile($arguments[0], 65536), 65536));
        $output = ['status' => 'PASS', 'canonical_hex' => bin2hex($bytes)];
    } elseif (in_array($command, ['protocol:apply-sequence', 'apply-sequence'], true)) {
        if (count($arguments) !== 1) {
            throw new ProtocolException('USAGE_ERROR');
        }
        $sequence = StrictJson::parse(boundedFile($arguments[0], 1048576), 1048576);
        if (!isset($sequence->records) || !is_array($sequence->records) || count($sequence->records) > 256) {
            throw new ProtocolException('SCHEMA_INVALID');
        }
        $records = array_map(static function (mixed $record) use ($verifier) {
            if (!$record instanceof stdClass) {
                throw new ProtocolException('SCHEMA_INVALID');
            }
            return $verifier->verify($record);
        }, $sequence->records);
        $max = $sequence->max_records ?? 100000;
        if (!is_int($max)) {
            throw new ProtocolException('SCHEMA_INVALID');
        }
        $output = ['status' => 'PASS', 'state' => IdentityDeriver::derive($records, $max)];
    } else {
        throw new ProtocolException('USAGE_ERROR');
    }
    echo json_encode($output, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), PHP_EOL;
    exit($exitCode);
} catch (\OnionServiceDiscovery\Storage\StorageException | \OnionServiceDiscovery\Signing\SignerException $error) {
    echo json_encode(['status' => 'FAIL', 'error' => $error->getMessage()], JSON_THROW_ON_ERROR), PHP_EOL;
    exit(4);
} catch (\OnionServiceDiscovery\Transport\TransportException $error) {
    echo json_encode(['status' => 'FAIL', 'error' => $error->getMessage()], JSON_THROW_ON_ERROR), PHP_EOL;
    exit(5);
} catch (InvalidArgumentException $error) {
    echo json_encode(['status' => 'FAIL', 'error' => $error->getMessage()], JSON_THROW_ON_ERROR), PHP_EOL;
    exit($error->getMessage() === 'USAGE_ERROR' ? 2 : 3);
} catch (Throwable) {
    echo '{"status":"FAIL","error":"INTERNAL_ERROR"}', PHP_EOL;
    exit(8);
}
