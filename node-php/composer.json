{
  "name": "onion-service-discovery/reference-node",
  "description": "Onion Service Discovery reference Node and offline protocol core",
  "type": "project",
  "license": "CC0-1.0",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-sodium": "*",
    "ext-iconv": "*",
    "opis/json-schema": "^2.6",
    "ext-curl": "*",
    "php-64bit": "^8.3"
  },
  "autoload": {
    "psr-4": {
      "OnionServiceDiscovery\\": "src/"
    }
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  }
}
