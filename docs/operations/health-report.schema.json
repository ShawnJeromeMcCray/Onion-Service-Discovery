{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onion-service-discovery.invalid/schemas/health-report-v1.json",
  "title": "Onion Service Discovery health report",
  "description": "Output of doctor and security:check (spec 32 section 10). Local diagnostics only: no paths, keys, passphrases, peer addresses, queries or client addresses. Every property is listed, so a new field needs a schema change and review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status", "software_version", "php_version", "protocol_versions", "db_schema", "role", "config_state",
    "crypto_state", "key_authentication_state", "tor_transport_state", "manifest_state", "publication",
    "sync_state", "source_concentration", "scheduler_state", "export_usage", "storage_usage", "backup_state", "disk_state",
    "node_health", "next_action", "signing_ledger", "security_check_summary", "warnings", "failures", "generated_at",
    "network_side_effects", "production_approval"
  ],
  "properties": {
    "status": { "enum": ["PASS", "WARN", "FAIL"] },
    "software_version": { "type": "string", "pattern": "^[0-9A-Za-z.+-]{1,64}$" },
    "php_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[0-9A-Za-z.+-]{0,32}$" },
    "protocol_versions": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
    "db_schema": { "type": ["integer", "null"], "minimum": 1 },
    "role": { "enum": ["publisher", "node", "combined", "client-host"] },
    "config_state": { "const": "PASS" },
    "crypto_state": { "$ref": "#/$defs/code" },
    "key_authentication_state": { "$ref": "#/$defs/code" },
    "tor_transport_state": { "$ref": "#/$defs/code" },
    "manifest_state": { "$ref": "#/$defs/code" },
    "publication": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/publication" }] },
    "sync_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest_sync_epoch", "quarantined_peers"],
      "properties": {
        "latest_sync_epoch": { "type": "integer", "minimum": 0 },
        "quarantined_peers": { "type": "integer", "minimum": 0 }
      }
    },
    "source_concentration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_peer_addresses", "distinct_node_identities", "configured_source_groups", "ungrouped_node_identities",
        "grouping_inconsistent", "concentrated", "operator_independence", "trust_authority_from_count"
      ],
      "properties": {
        "active_peer_addresses": { "type": "integer", "minimum": 0 },
        "distinct_node_identities": { "type": "integer", "minimum": 0 },
        "configured_source_groups": { "type": "integer", "minimum": 0 },
        "ungrouped_node_identities": { "type": "integer", "minimum": 0 },
        "grouping_inconsistent": { "type": "boolean" },
        "concentrated": { "type": "boolean" },
        "operator_independence": { "const": "NOT_PROVEN" },
        "trust_authority_from_count": { "const": false }
      }
    },
    "scheduler_state": {
      "oneOf": [
        { "const": "NOT_OBSERVED" },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "snapshot": { "$ref": "#/$defs/freshness" },
            "publisher_checks": { "$ref": "#/$defs/freshness" }
          }
        }
      ]
    },
    "export_usage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["blob_files", "blob_bytes", "max_files", "max_bytes"],
          "properties": {
            "blob_files": { "type": "integer", "minimum": 0 },
            "blob_bytes": { "type": "integer", "minimum": 0 },
            "max_files": { "type": "integer", "minimum": 1 },
            "max_bytes": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "storage_usage": {
      "description": "Use of the store's record, state, operational-row and on-disk byte budgets (WARN from 80 %) and whether node:maintain may prune superseded checkpoints; null without a readable store.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["signed_records", "max_records", "pruned_records", "state_bytes", "max_state_bytes", "operational_rows", "max_operational_rows", "store_bytes", "max_store_bytes", "usage_percent", "state", "record_pruning"],
          "properties": {
            "signed_records": { "type": "integer", "minimum": 0 },
            "max_records": { "type": "integer", "minimum": 1 },
            "pruned_records": { "type": "integer", "minimum": 0 },
            "state_bytes": { "type": "integer", "minimum": 0 },
            "max_state_bytes": { "type": "integer", "minimum": 1 },
            "operational_rows": { "type": "integer", "minimum": 0 },
            "max_operational_rows": { "type": "integer", "minimum": 1 },
            "store_bytes": { "type": ["integer", "null"], "minimum": 0 },
            "max_store_bytes": { "type": "integer", "minimum": 1 },
            "usage_percent": { "type": "integer", "minimum": 0 },
            "state": { "enum": ["PASS", "WARN", "FAIL"] },
            "record_pruning": { "enum": ["ENABLED", "MIGRATION_REQUIRED"] }
          }
        }
      ]
    },
    "backup_state": { "$ref": "#/$defs/code" },
    "disk_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["free_bytes"],
      "properties": { "free_bytes": { "type": ["number", "null"], "minimum": 0 } }
    },
    "node_health": { "enum": ["HEALTHY", "READ_ONLY", "DEGRADED", "ERROR", "NOT_INITIALIZED", "NOT_APPLICABLE"] },
    "next_action": { "type": ["string", "null"], "maxLength": 1000 },
    "signing_ledger": {
      "description": "The signing ledger beside the Node key compared with the store: CONSISTENT; BEHIND_STORE (the next signing run raises it); AHEAD_OF_STORE (the store is older than what the key signed, signing stops until node:snapshot --adopt-signed-chain); NOT_PRESENT (written by the next signing run); INVALID (signing stops); NOT_CHECKED (the store could not be compared); NOT_APPLICABLE without a Node key.",
      "enum": ["CONSISTENT", "BEHIND_STORE", "AHEAD_OF_STORE", "NOT_PRESENT", "INVALID", "NOT_CHECKED", "NOT_APPLICABLE"]
    },
    "security_check_summary": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
      "additionalProperties": { "enum": ["PASS", "WARN", "FAIL", "NOT_APPLICABLE"] }
    },
    "security_findings": {
      "description": "security:check only: focused checks with a remediation (spec 32 section 9).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status", "remediation"],
        "properties": {
          "check": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "status": { "enum": ["PASS", "WARN", "FAIL", "NOT_APPLICABLE"] },
          "remediation": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/code" } },
    "failures": { "type": "array", "items": { "$ref": "#/$defs/code" } },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "network_side_effects": { "const": false },
    "production_approval": { "const": "OPEN" }
  },
  "$defs": {
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,79}$" },
    "freshness": { "enum": ["RECENT", "STALE", "NOT_OBSERVED"] },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "manifest_state", "revision", "manifest_hash", "self_verification", "announcement", "active_index_membership", "source_integrity"],
      "properties": {
        "overall": { "$ref": "#/$defs/code" },
        "manifest_state": { "$ref": "#/$defs/code" },
        "revision": { "type": ["integer", "null"], "minimum": 1 },
        "manifest_hash": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }] },
        "self_verification": { "$ref": "#/$defs/code" },
        "announcement": { "$ref": "#/$defs/code" },
        "active_index_membership": { "$ref": "#/$defs/code" },
        "source_integrity": { "$ref": "#/$defs/code" }
      }
    }
  }
}
