{
  "name": "onion-service-discovery-web-local-search-client",
  "version": "0.0.0",
  "private": true,
  "description": "Onion Service Discovery local browser search and signature-verification client",
  "license": "CC0-1.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "schemas:build": "node tools/build-validators.mjs",
    "build": "node tools/build-client.mjs",
    "demo": "npm run build && node tools/serve-demo.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  }
}
